  (text "POWER SECTION - LT8614 Buck (12V->3V3) + TPS7A4700 LDO (3V3->1V8)" (at 12.7 342.9 0) (effects (font (size 1.27 1.27) (thickness 0.254))))
  (text "PCIE GEN5 x16 HOST INTERFACE - BCM84881 SerDes (16-lane)" (at 12.7 101.6 0) (effects (font (size 1.27 1.27) (thickness 0.254))))
